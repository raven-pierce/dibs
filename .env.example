# Copy to .env and fill in. .env is gitignored and never committed.

# Contact embedded in the User-Agent so site operators can reach you instead of
# blocking you. A URL you control or a mailbox. Required for crates.io, CIPO,
# USPTO, Packagist (they report UNKNOWN without it). Do not use a fake value.
DIBS_CONTACT=

# Optional. Lifts GitHub's rate limit (60/hr -> 5,000/hr). Any token, public read.
GITHUB_TOKEN=

# Optional. Enables the Brave web-footprint provider.
BRAVE_API_KEY=
